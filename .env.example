# Required: n8n webhook URL for the chat proxy
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/your-webhook-id/chat

# Optional: Shared secret for n8n webhook authentication
N8N_SHARED_SECRET=

# Optional: Google Analytics 4 Measurement ID (defaults to empty, disabling GA)
NEXT_PUBLIC_GA_ID=

# Required for production: Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=

# ── Klaviyo email signup (CTRL-A capture forms) ──
# Required to actually subscribe: the Klaviyo List ID the signups join.
# Find it in Klaviyo: Audience > Lists & Segments > (your list) > Settings.
KLAVIYO_LIST_ID=

# Optional but recommended: a Klaviyo Private API key (pk_live_...).
# When set, subscribes happen server-side (key never exposed) and honor
# the list's opt-in settings. Without it, the form falls back to Klaviyo's
# public Client API using the company id below (still works, needs a List ID).
# Scope the key to "List: Full" and "Profiles: Full".
KLAVIYO_PRIVATE_KEY=

# Optional: public Klaviyo company/site id. Defaults to the site's (U3jthw),
# which already powers onsite tracking in app/layout.tsx.
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=U3jthw

# Optional: Klaviyo API revision date (defaults to 2024-10-15).
KLAVIYO_REVISION=

# Optional: dedicated list for the /card business-card QR onboarding flow.
# If unset, /card falls back to KLAVIYO_LIST_ID like everything else.
# Create it in Klaviyo: Audience > Lists & Segments > New List (e.g.
# "Business Card Leads"), then paste its id here. Must be NEXT_PUBLIC_
# because the client reads it before calling /api/klaviyo/subscribe.
NEXT_PUBLIC_KLAVIYO_CARD_LIST_ID=

# ── CTRL-A credits (Supabase engagement economy) ──
# Required for earning credits: the Supabase Service Role key. Used ONLY by
# the server routes in app/api/credits to award/spend credits (the browser
# can never forge them). Find it in Supabase: Project Settings > API >
# service_role secret. Keep it secret, never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── CTRL-A Discord ──
# The community lives at the CTRL-A Discord. The link appears in the CTRL-A
# footer, the join section on /ctrla, and the email-signup success state.
#
# NOTHING is hardcoded: with none of these set, every Discord link and the
# whole join section simply do not render. That is deliberate. A dead or
# wrong invite is worse than no invite.
#
# Set this one and everything turns on. Bare code or full URL both work.
# Discord > right-click the server > Invite People > set to never expire.
NEXT_PUBLIC_DISCORD_INVITE=

# Optional: one invite per surface. Discord counts uses per invite code, so
# separate codes tell you which surface actually sends people (Server
# Settings > Invites). Each falls back to NEXT_PUBLIC_DISCORD_INVITE above.
NEXT_PUBLIC_DISCORD_INVITE_FOOTER=
NEXT_PUBLIC_DISCORD_INVITE_HUB=
NEXT_PUBLIC_DISCORD_INVITE_SIGNUP=

# Optional: live server stats on the /ctrla join section (next Feedback
# Friday, member count). Without these the section still renders, just with
# no proof line. Use a SEPARATE read-only bot, never the admin setup bot.
# Guild id: right-click the server > Copy Server ID (needs Developer Mode).
DISCORD_GUILD_ID=
DISCORD_SITE_BOT_TOKEN=
