<style>
  @page { size: 8.5in 11in; margin: 1in; }
  body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1c1030; line-height: 1.45; }
  h1 { font-size: 24pt; font-weight: bold; color: #0F0820; margin: 0 0 4pt; }
  .subtitle { font-family: Georgia, serif; font-style: italic; font-size: 12pt; color: #5b3fa0; margin: 0 0 18pt; }
  h2 { font-size: 15pt; font-weight: bold; color: #0F0820; border-bottom: 2pt solid #E3C24A; padding-bottom: 3pt; margin: 22pt 0 8pt; }
  h3 { font-size: 12pt; font-weight: bold; color: #5b3fa0; margin: 14pt 0 4pt; }
  p { margin: 0 0 8pt; }
  .meta { font-size: 9pt; color: #7a7086; letter-spacing: 1pt; text-transform: uppercase; margin-bottom: 4pt; }
  table { border-collapse: collapse; width: 100%; margin: 8pt 0 12pt; }
  th { background: #0F0820; color: #F0E6E0; font-size: 10pt; text-align: left; padding: 6pt 8pt; }
  td { border: 1pt solid #d9d2c7; padding: 6pt 8pt; font-size: 10.5pt; vertical-align: top; }
  tr.alt td { background: #f8f1e7; }
  .callout { background: #f8f1e7; border-left: 4pt solid #E3C24A; padding: 8pt 12pt; margin: 10pt 0; }
